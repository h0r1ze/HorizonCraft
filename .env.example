# Скопируйте в .env и поправьте. Проще: запустите ./install.sh, он создаст .env сам.

# Пароль администратора. Применяется ТОЛЬКО при первом запуске, пока в панели нет пользователя.
# Позже меняйте его в панели (Настройки → Пароль) или скриптом ./reset-password.sh
ADMIN_PASSWORD=change-me-please

# Абсолютный путь к данным (серверы, бэкапы, настройки панели). Не используйте относительные пути.
DATA_DIR=/opt/horizoncraft/data

# Порт веб-панели на хосте
PANEL_PORT=8088

# Часовой пояс для панели и Minecraft-серверов (расписание, время в логах)
TZ=UTC

# Режим агента (необязательно). Если задан токен длиной от 24 символов, эту машину можно подключить
# как ноду к главной панели: Настройки → Ноды. Проще всего включить командой ./install.sh --agent
# Токен даёт полный доступ к Docker на этой машине: храните его в секрете.
# AGENT_TOKEN=
